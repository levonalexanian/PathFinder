<?xml version="1.0"?>
<!-- ROS-side URDF for the pathfinder diff-drive car.
     This drives robot_state_publisher / TF only. The Gazebo simulation
     uses gazebo/car.sdf (which carries the DiffDrive plugin). -->
<robot name="pathfinder_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="base_size_x" value="0.40"/>
  <xacro:property name="base_size_y" value="0.30"/>
  <xacro:property name="base_size_z" value="0.15"/>
  <xacro:property name="base_mass"   value="2.0"/>

  <xacro:property name="wheel_radius"     value="0.05"/>
  <xacro:property name="wheel_width"      value="0.04"/>
  <xacro:property name="wheel_mass"       value="0.1"/>
  <xacro:property name="wheel_separation" value="0.32"/>

  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass"   value="0.05"/>
  <xacro:property name="caster_x"      value="0.15"/>

  <material name="car_dark_blue">
    <color rgba="0.1 0.15 0.4 1.0"/>
  </material>
  <material name="wheel_dark_gray">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_size_x} ${base_size_y} ${base_size_z}"/>
      </geometry>
      <material name="car_dark_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_size_x} ${base_size_y} ${base_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass * (base_size_y*base_size_y + base_size_z*base_size_z) / 12.0}"
        iyy="${base_mass * (base_size_x*base_size_x + base_size_z*base_size_z) / 12.0}"
        izz="${base_mass * (base_size_x*base_size_x + base_size_y*base_size_y) / 12.0}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <xacro:macro name="drive_wheel" params="suffix y_sign">
    <link name="wheel_${suffix}">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_dark_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12.0}"
          iyy="${wheel_mass * wheel_radius*wheel_radius / 2.0}"
          izz="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12.0}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <!-- Wheels mounted at y = +-(wheel_separation/2); axis along y -->
    <joint name="${suffix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${suffix}"/>
      <origin xyz="0 ${y_sign * wheel_separation / 2.0} ${-base_size_z/2 + wheel_radius - 0.02}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel suffix="left"  y_sign="1"/>
  <xacro:drive_wheel suffix="right" y_sign="-1"/>

  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="wheel_dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${2.0 * caster_mass * caster_radius * caster_radius / 5.0}"
        iyy="${2.0 * caster_mass * caster_radius * caster_radius / 5.0}"
        izz="${2.0 * caster_mass * caster_radius * caster_radius / 5.0}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <!-- Free-swivel passive caster at the front. Caster bottom is aligned with wheel
       bottom (base z = -0.095) so the caster doesn't drag into the ground. -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 -0.07" rpy="0 0 0"/>
  </joint>

</robot>
