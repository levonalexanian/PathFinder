<?xml version="1.0"?>
<!-- Gazebo-side model for the pathfinder diff-drive car.
     Carries the DiffDrive plugin (cmd_vel -> wheel velocities).
     ROS-side TF/visualization is driven by urdf/car.urdf. -->
<sdf version="1.9">
  <model name="pathfinder_car">
    <!-- z = ground_top (0) + wheel_radius (0.05) - wheel_z_in_base (-0.045) = 0.095
         so the wheels rest cleanly on the ground from t=0 with no settling. -->
    <pose>0.5 0.5 0.095 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.01875</ixx>
          <iyy>0.030416666666666668</iyy>
          <izz>0.041666666666666664</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.40 0.30 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.15 0.4 1</ambient>
          <diffuse>0.15 0.2 0.5 1</diffuse>
          <specular>0.1 0.15 0.4 1</specular>
        </material>
      </visual>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.40 0.30 0.15</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- 4-wheel layout matching the URDF visual. Rear wheels (rl, rr) are the
         driven pair (high mu both axes for grip). Front wheels (fl, fr) get low
         lateral friction (mu2 small) so the car can turn without scrubbing.
         Cylinder geometry is rotated pi/2 around x inside the visual/collision,
         so the link frame stays aligned with the model and the joint axis lives
         unambiguously in the link's own y-axis. -->
    <link name="wheel_fl">
      <pose>0.13 0.16 -0.045 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00012500000000000003</ixx>
          <iyy>7.583333333333335e-05</iyy>
          <izz>7.583333333333335e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_fl_visual">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="wheel_fl_collision">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="wheel_fr">
      <pose>0.13 -0.16 -0.045 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00012500000000000003</ixx>
          <iyy>7.583333333333335e-05</iyy>
          <izz>7.583333333333335e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_fr_visual">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="wheel_fr_collision">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="wheel_rl">
      <pose>-0.13 0.16 -0.045 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00012500000000000003</ixx>
          <iyy>7.583333333333335e-05</iyy>
          <izz>7.583333333333335e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_rl_visual">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="wheel_rl_collision">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="wheel_rr">
      <pose>-0.13 -0.16 -0.045 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00012500000000000003</ixx>
          <iyy>7.583333333333335e-05</iyy>
          <izz>7.583333333333335e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_rr_visual">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="wheel_rr_collision">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="fl_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_fl</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.005</damping>
        </dynamics>
      </axis>
    </joint>

    <joint name="fr_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_fr</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.005</damping>
        </dynamics>
      </axis>
    </joint>

    <joint name="rl_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_rl</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.005</damping>
        </dynamics>
      </axis>
    </joint>

    <joint name="rr_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_rr</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.005</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- cmd_vel (gz.msgs.Twist) -> wheel velocities. Topic remapped to /cmd_vel.
         Diff-drive runs on the rear wheels; the low-mu2 fronts coast and steer. -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>rl_wheel_joint</left_joint>
      <right_joint>rr_wheel_joint</right_joint>
      <wheel_separation>0.32</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>cmd_vel</topic>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <max_linear_velocity>1.0</max_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
    </plugin>

    <!-- Publish pose updates on /model/pathfinder_car/pose for the ROS bridge. -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_model_pose>true</publish_model_pose>
      <update_frequency>50</update_frequency>
    </plugin>
  </model>
</sdf>
