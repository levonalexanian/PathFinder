<?xml version="1.0"?>
<!--
  car_world.sdf - Gazebo world for the pathfinder diff-drive car showcase.

  Obstacle layout is intentionally IDENTICAL to
  src/robots/pathfinder_robot_drone/gazebo/worlds/drone_world.sdf so the planning octomap
  (maps/demo_world.bt, generated by src/infra/pathfinder_core/tools/generate_demo_map.cpp)
  can be reused as-is for both robots.

  At floor level the car effectively only sees the 3 posts; the overhangs
  (z in [2.0, 2.5]) and the low ceiling (z in [1.0, 1.2]) clear the chassis
  entirely. They are kept here for visual continuity with the drone world.

    Posts (0.5 x 0.5 x 5 m, matches generate_demo_map.cpp exactly):
      (x=2, y=2), (x=5, y=7), (x=8, y=3)

    Overhangs (2 x 2 x 0.5 m slabs centered at z=2.25):
      center (4, 5), center (7.5, 2)

    Low ceiling (2 x 2 x 0.2 m slab centered at z=1.1):
      center (1.5, 1.5)

  Ground plane is 10 x 10 m, dark green.

  If you edit these positions, update drone_world.sdf and generate_demo_map.cpp too.
-->
<sdf version="1.9">
  <world name="pathfinder_car_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <pose>5 5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 10 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 10 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.1 1</ambient>
            <diffuse>0.1 0.4 0.1 1</diffuse>
            <specular>0.1 0.2 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="post_a">
      <static>true</static>
      <pose>2 2 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 5</size></box></geometry>
          <material>
            <ambient>0.5 0.3 0.2 1</ambient>
            <diffuse>0.6 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="post_b">
      <static>true</static>
      <pose>5 7 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 5</size></box></geometry>
          <material>
            <ambient>0.5 0.3 0.2 1</ambient>
            <diffuse>0.6 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="post_c">
      <static>true</static>
      <pose>8 3 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 5</size></box></geometry>
          <material>
            <ambient>0.5 0.3 0.2 1</ambient>
            <diffuse>0.6 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="overhang_a">
      <static>true</static>
      <pose>4 5 2.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 2 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 2 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.5 1</ambient>
            <diffuse>0.4 0.4 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="overhang_b">
      <static>true</static>
      <pose>7.5 2 2.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 2 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 2 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.5 1</ambient>
            <diffuse>0.4 0.4 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="low_ceiling">
      <static>true</static>
      <pose>1.5 1.5 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 2 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 2 0.2</size></box></geometry>
          <material>
            <ambient>0.4 0.2 0.2 1</ambient>
            <diffuse>0.5 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
